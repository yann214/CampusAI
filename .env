# Copier ce fichier en ".env" et remplir les valeurs réelles.
# Ne jamais commiter le fichier ".env" (déjà exclu dans .gitignore).

ENVIRONMENT=development

# Clé API Groq — à récupérer sur https://console.groq.com


GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b

EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small

VECTORSTORE_PATH=./data/vectorstore
COLLECTION_NAME=orientation_docs

RETRIEVAL_TOP_K=4

# En production, remplacer par l'URL exacte du frontend, ex: https://mon-app.com
ALLOWED_ORIGINS=["*"]

# Filtrage des tables lors de l'ingestion SQL.
# Si SQL_INCLUDED_TABLES est renseigné, SEULES ces tables sont ingérées.
# Sinon, toutes les tables sont ingérées SAUF celles dans SQL_EXCLUDED_TABLES.
SQL_INCLUDED_TABLES=[]
SQL_EXCLUDED_TABLES=["ai_cache","users"]

RETRIEVAL_TOP_K=4

# Cache sémantique : évite de rappeler Groq pour des questions déjà posées
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.92

# Rate limiting : protège le quota Groq gratuit
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ASK=20/minute

# --- MySQL (table `documents`) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=univ_douala_fs

# Racine des fichiers téléchargeables (PDF/Word), avec sous-dossiers
FILES_ROOT_DIR=./data/files
